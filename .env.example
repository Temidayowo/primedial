# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon). Local dev and production currently
# share the same database - see the "Known issues" note in the README
# (or ask in the project chat) before reseeding.
DATABASE_URL=

# Session/JWT signing secret for NextAuth. Generate with:
#   npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email - verification, password reset, welcome).
# If unset, emails are skipped and the link is logged to the console
# instead, so auth flows stay testable without a real key.
RESEND_API_KEY=
EMAIL_FROM=
