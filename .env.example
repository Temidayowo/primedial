# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon). Local dev and production currently
# share the same database - see the "Known issues" note in the README
# (or ask in the project chat) before reseeding.
DATABASE_URL=

# Session/JWT signing secret for NextAuth. Generate with:
#   npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email - verification, password reset, welcome).
# If unset, emails are skipped and the link is logged to the console
# instead, so auth flows stay testable without a real key.
RESEND_API_KEY=
EMAIL_FROM=

# Paystack (Card and Bank Transfer checkout - see src/lib/payments/paystack.ts).
# Public key is exposed to the browser for the inline popup; secret key
# signs webhook payloads and authenticates the server-side verify call.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# OPay (hosted-checkout redirect flow - see src/lib/payments/opay.ts, which
# flags the parts of this integration that need re-verifying against
# OPay's current merchant docs before going live).
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=

# Cloudflare R2 (admin image/PDF uploads - see src/lib/storage.ts).
# Account ID: Cloudflare dashboard -> R2 overview. Access keys: R2 -> Manage
# API tokens -> Create token (Object Read & Write, scoped to the bucket).
# R2_PUBLIC_URL is the bucket's public r2.dev URL or custom domain, with no
# trailing slash. The bucket needs a CORS rule allowing PUT from your site's
# origin(s) with the Content-Type and Cache-Control headers.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=primedialsolutions
R2_PUBLIC_URL=
