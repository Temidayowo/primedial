// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  OPAY
}

model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String   @unique(map: "product_slug_key")
  images       String[]
  description  String
  inStock      Boolean  @default(true)
  features     String[]
  specSheetUrl String?
  price        Decimal  @default(0.0) @db.Decimal(12, 2)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String @db.Uuid
  brand   Brand  @relation(fields: [brandId], references: [id])

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model Category {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  address       Json?     @db.Json
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  addresses      Address[]
  paymentMethods PaymentMethod[]
  cartItems      CartItem[]
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Backs a simple fixed-window rate limiter (see src/lib/rate-limit.ts).
// `key` encodes both the action and the thing being limited, e.g.
// "login:someone@example.com".
model RateLimitAttempt {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}

model Address {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label      String? // e.g. "Home", "Office"
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]
}

// Deliberately does not store real card numbers or CVV - checkout itself
// goes through Paystack's popup (see src/lib/actions/payments.action.ts),
// which collects card details directly into Paystack's own iframe and
// never sends them to this app. This model is a reference-only "cards on
// file" list for the account page; it's never read from when actually
// charging a card. Only ever store display-safe fields here (brand, last
// 4 digits, expiry, cardholder name) - never a full PAN, and never a CVV
// under any circumstances (PCI-DSS forbids storing CVV after
// authorization, full stop, regardless of encryption).
model PaymentMethod {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand          String // e.g. "Visa", "Mastercard"
  last4          String
  cardholderName String
  expiryMonth    Int
  expiryYear     Int
  isDefault      Boolean @default(false)

  createdAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber String      @unique
  status      OrderStatus @default(PROCESSING)
  total       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shippingAddressId String?  @db.Uuid
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)

  // Set on the order the moment it's created, before any money has moved -
  // the order row is the one thing all three payment paths (Paystack popup
  // verify call, Paystack webhook, OPay webhook) update, so a payment can
  // be confirmed even if the client never comes back (tab closed, popup
  // dismissed after a successful charge, etc).
  paymentStatus    PaymentStatus    @default(PENDING)
  paymentProvider  PaymentProvider?
  // Regenerated on every payment attempt (retrying after a failed/abandoned
  // attempt reuses the same order but gets a fresh reference), so this is
  // what ties a specific Paystack/OPay transaction back to this order.
  paymentReference String?          @unique
  paidAt           DateTime?

  items OrderItem[]
}

model OrderItem {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity Int
  price    Decimal @db.Decimal(12, 2) // product price at the time of order

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}
